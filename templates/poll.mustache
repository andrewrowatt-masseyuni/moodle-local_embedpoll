{{!
    @template local_embedpoll/poll

    Renders an embedded poll: on the page, interactive; in the editor's preview, with its buttons
    disabled.

    A compact poll puts its options side by side, on one line, wrapping only when they do not fit.
    It has no progress bars and no check icons: the chosen option is the tinted button, and
    aria-pressed says so to assistive technology.

    Context variables required for this template:
    * pollid - Poll id
    * contextid - Moodle context id
    * compact - Whether the options are shown side by side, on one line
    * canvote - Whether the user may cast/change a vote
    * canviewresults - Whether the user always sees results
    * showresults - Whether results are revealed to this user
    * total - Total number of votes
    * totaltext - Localised, pluralised total-votes label (e.g. "1 vote", "5 votes")
    * hasvotes - Whether there is at least one vote
    * items - Array of {optionid, label, count, percent, selected}

    Example context (json):
    {
        "pollid": 7, "contextid": 42, "compact": false, "canvote": true, "canviewresults": false,
        "hasvoted": true, "showresults": true, "total": 3, "totaltext": "3 votes", "hasvotes": true,
        "items": [
            {"optionid": 1, "label": "Red", "count": 2, "percent": 67, "selected": true},
            {"optionid": 2, "label": "Green", "count": 1, "percent": 33, "selected": false},
            {"optionid": 3, "label": "Blue", "count": 0, "percent": 0, "selected": false}
        ]
    }
}}
<div class="filter-embedpoll{{#compact}} embedpoll-compact{{/compact}}" data-region="filter-embedpoll" data-pollid="{{pollid}}" data-contextid="{{contextid}}">
    {{#compact}}
    <div class="d-flex flex-wrap embedpoll-options" role="group" aria-label="{{#str}}polloptions, local_embedpoll{{/str}}">
        {{#items}}
        <button type="button"
                class="btn embedpoll-option{{#selected}} embedpoll-selected{{/selected}}"
                data-action="poll-vote"
                data-optionid="{{optionid}}"
                aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"
                {{^canvote}}disabled{{/canvote}}>
            <span class="embedpoll-option-label">{{label}}</span>
            {{#showresults}}
            <span class="embedpoll-option-stat ml-1">{{percent}}%<span class="sr-only"> ({{count}})</span></span>
            {{/showresults}}
        </button>
        {{/items}}
    </div>
    {{/compact}}
    {{^compact}}
    <div class="list-group embedpoll-options" role="group" aria-label="{{#str}}polloptions, local_embedpoll{{/str}}">
        {{#items}}
        <button type="button"
                class="list-group-item list-group-item-action embedpoll-option text-left{{#selected}} embedpoll-selected{{/selected}}"
                data-action="poll-vote"
                data-optionid="{{optionid}}"
                aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"
                {{^canvote}}disabled{{/canvote}}>
            <span class="d-flex align-items-center justify-content-between">
                <span class="embedpoll-option-label">
                    {{#selected}}<i class="fa-solid fa-circle-check text-primary mr-2" aria-hidden="true"></i>{{/selected}}
                    {{^selected}}<i class="fa-regular fa-circle embedpoll-option-bullet mr-2" aria-hidden="true"></i>{{/selected}}
                    {{label}}
                </span>
                {{#showresults}}
                <span class="embedpoll-option-stat text-muted ml-2">{{percent}}%<span class="sr-only"> ({{count}})</span></span>
                {{/showresults}}
            </span>
            {{#showresults}}
            <span class="progress embedpoll-progress mt-2" aria-hidden="true">
                <span class="progress-bar" role="progressbar" style="width: {{percent}}%"
                      aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"></span>
            </span>
            {{/showresults}}
        </button>
        {{/items}}
    </div>
    {{/compact}}
    {{#showresults}}
    <p class="embedpoll-total text-muted small mt-2 mb-0">
        {{#hasvotes}}<span data-region="embedpoll-total">{{totaltext}}</span>{{/hasvotes}}
        {{^hasvotes}}{{#str}}novotesyet, local_embedpoll{{/str}}{{/hasvotes}}
    </p>
    {{/showresults}}
    {{^showresults}}
    <p class="embedpoll-hint text-muted small mt-2 mb-0">{{#str}}resultshiddenhint, local_embedpoll{{/str}}</p>
    {{/showresults}}
</div>
