{{!
    @template local_embedpoll/options_editor

    The lines the poll form's options are written in, which take the place of its options textarea.

    "Add option" has a stand-in, for when the poll has as many lines as it may have options. The
    stand-in adds nothing, and its tooltip says why. local_embedpoll/options_editor shows one or the
    other.

    Context variables required for this template:
    * lines - The lines to start with, each as local_embedpoll/options_editor_line takes it

    Example context (json):
    {
        "lines": [{"label": "Yes"}, {"label": "No"}, {"label": ""}]
    }
}}
<div class="local-embedpoll-options w-100" data-region="local_embedpoll-options">
    <div data-region="local_embedpoll-optionlist">
        {{#lines}}
            {{> local_embedpoll/options_editor_line }}
        {{/lines}}
    </div>
    <button type="button" class="btn btn-link px-0" data-action="local_embedpoll-addoption">
        {{#pix}} t/add, core {{/pix}}{{#str}} addoption, local_embedpoll {{/str}}
    </button>
    <button type="button" class="btn btn-link px-0" aria-disabled="true" data-region="local_embedpoll-maxoptions"
            data-toggle="tooltip" title="{{#cleanstr}} maxoptionsreached, local_embedpoll {{/cleanstr}}" hidden>
        {{#pix}} t/add, core {{/pix}}{{#str}} addoption, local_embedpoll {{/str}}
    </button>
</div>
